# Polymarket API Configuration
API_BASE_URL=https://gamma-api.polymarket.com/markets
OI_API_BASE_URL=https://data-api.polymarket.com/oi

# Data Filtering Thresholds
MIN_VOLUME_USD=100000
MIN_OPEN_INTEREST_USD=50000

# Database
DATABASE_PATH=polymarket_bi.db

# API Request Settings
API_TIMEOUT_SECONDS=10
API_RATE_LIMIT_PER_HOST=20
API_RATE_LIMIT_TOTAL=200

# Logging
LOG_LEVEL=INFO

# Dashboard
DASHBOARD_PORT=8501
DASHBOARD_LOG_LEVEL=error
